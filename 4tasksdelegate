        private static void RunCreditCardExample()
        {
            Console.WriteLine("№3");

            Console.Write("Введіть номер картки: ");
            string cardNumber = ReadRequiredLine();

            Console.Write("Введіть ПІБ власника: ");
            string ownerName = ReadRequiredLine();

            DateTime expirationDate = ReadDate("Введіть термін дії картки (дд.мм.рррр): ");

            Console.Write("Введіть PIN-код (4 цифри): ");
            string pin = ReadPin();

            decimal creditLimit = ReadNonNegativeDecimal("Введіть кредитний ліміт: ");
            decimal initialBalance = ReadNonNegativeDecimal("Введіть початкову суму грошей: ");
            decimal targetAmount = ReadNonNegativeDecimal("Введіть суму для відстеження: ");

            var card = new CreditCard(
                cardNumber,
                ownerName,
                expirationDate,
                pin,
                creditLimit,
                initialBalance,
                targetAmount);

            card.Deposited += (_, e) =>
                Console.WriteLine(
                    $"Поповнення на {e.Amount}. Баланс: {e.Balance}; використано кредиту: {e.CreditUsed}");

            card.Spent += (_, e) =>
                Console.WriteLine(
                    $"Витрата {e.Amount}. Баланс: {e.Balance}; використано кредиту: {e.CreditUsed}");

            card.CreditUsageStarted += (_, e) =>
                Console.WriteLine($"Почалося використання кредитних коштів. Борг: {e.CreditUsed}");

            card.TargetAmountReached += (_, e) =>
                Console.WriteLine($"Досягнуто задану суму. Баланс: {e.Balance}");

            card.PinChanged += (_, _) =>
                Console.WriteLine("PIN-код успішно змінено.");

            Console.WriteLine();
            Console.WriteLine($"Картка власника {card.OwnerName}, дійсна до {card.ExpirationDate:dd.MM.yyyy}.");
            Console.WriteLine($"Поточний баланс: {card.Balance}; кредитний ліміт: {card.CreditLimit}.");

            while (true)
            {
                Console.WriteLine();
                Console.WriteLine("Оберіть дію: 1 — поповнити, 2 — витратити, 3 — змінити PIN, 0 — завершити");
                Console.Write("Ваш вибір: ");
                string choice = (Console.ReadLine() ?? string.Empty).Trim();

                try
                {
                    if (choice == "1")
                    {
                        decimal amount = ReadPositiveDecimal("Введіть суму поповнення: ");
                        card.Deposit(amount);
                    }
                    else if (choice == "2")
                    {
                        decimal amount = ReadPositiveDecimal("Введіть суму витрати: ");
                        card.Spend(amount);
                    }
                    else if (choice == "3")
                    {
                        Console.Write("Введіть поточний PIN: ");
                        string oldPin = ReadPin();

                        Console.Write("Введіть новий PIN: ");
                        string newPin = ReadPin();

                        card.ChangePin(oldPin, newPin);
                    }
                    else if (choice == "0")
                    {
                        break;
                    }
                    else
                    {
                        Console.WriteLine("Невідома команда. Спробуйте ще раз.");
                    }
                }
                catch (ArgumentException ex)
                {
                    Console.WriteLine($"Помилка введення: {ex.Message}");
                }
                catch (InvalidOperationException ex)
                {
                    Console.WriteLine($"Операцію не виконано: {ex.Message}");
                }
            }

            Console.WriteLine();
        }





