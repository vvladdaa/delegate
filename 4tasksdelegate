        private static void RunArrayExamples()
        {
            Console.WriteLine("№1");
            Console.Write("Введіть цілі числа через пробіл або кому: ");

            string input = Console.ReadLine() ?? string.Empty;
            string[] parts = input.Split(
                new[] { ' ', ',', ';', '\t' },
                StringSplitOptions.RemoveEmptyEntries);

            var numbers = new List<int>();

            foreach (string part in parts)
            {
                if (int.TryParse(part, out int number))
                    numbers.Add(number);
                else
                    Console.WriteLine($"Значення \"{part}\" пропущено: це не ціле число.");
            }

            int[] array = numbers.ToArray();

            Console.WriteLine("Парні:     " + string.Join(", ", ArrayOperations.GetEven(array)));
            Console.WriteLine("Непарні:   " + string.Join(", ", ArrayOperations.GetOdd(array)));
            Console.WriteLine("Прості:    " + string.Join(", ", ArrayOperations.GetPrimes(array)));
            Console.WriteLine("Фібоначчі: " + string.Join(", ", ArrayOperations.GetFibonacci(array)));
            Console.WriteLine();
        }



